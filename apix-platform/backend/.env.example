# Database connection
# For PostgreSQL / TimescaleDB:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/apix_db
# For SQLite (default, zero setup needed):
DATABASE_URL=sqlite+aiosqlite:///./apix.db

# API Settings
ENVIRONMENT=development
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Scraper Settings
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT_MS=15000
SCRAPER_CONCURRENCY=3
SCRAPER_DOMAIN_DELAY_SEC=1.0
USE_MOCK_FALLBACK=true

# Index Calculation Baseline
BASE_YEAR_PRICE_INDEX=100.0
MAD_THRESHOLD=3.5
